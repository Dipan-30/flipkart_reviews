MONGO_URI=mongodb://localhost:27017/flipkart_reviews
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OLLAMA_BASE_URL=http://localhost:11434

# Primary model. Used for backward-compatible single-model fields and as the
# fallback when OLLAMA_MODELS is left empty.
OLLAMA_MODEL=gemma3:4b

# Multi-model sentiment comparison. Comma separated list of Ollama models.
# Every configured model analyzes the SAME review independently.
# Install them first (models are never downloaded automatically):
#   ollama pull gemma3:4b
#   ollama pull qwen2.5:7b
#   ollama pull llama3.1:8b
# Lower-RAM alternative: OLLAMA_MODELS=gemma3:4b,qwen2.5:3b,phi4-mini
# Leaving this empty (or listing a single model) keeps the app in
# single-model mode.
OLLAMA_MODELS=gemma3:4b,qwen2.5:7b,llama3.1:8b

# How many reviews are analyzed in parallel.
OLLAMA_CONCURRENCY=1
# How many models are queried in parallel for the same review.
# 1 = fully sequential (lowest RAM usage). Raise only if Ollama can keep
# several models loaded at once (see OLLAMA_MAX_LOADED_MODELS in Ollama).
OLLAMA_MODEL_CONCURRENCY=1
OLLAMA_TIMEOUT=120

# Ask Ollama for strict JSON output (format="json").
# Recommended with multiple models. Set to false to reproduce the original
# prompt-only behaviour of the single gemma3:4b pipeline.
OLLAMA_FORCE_JSON=true

# Optional: let an LLM phrase the product recommendation explanation.
# The recommendation tier/score itself is always computed deterministically
# from the analyzed review data, never by the LLM.
RECOMMENDATION_LLM_NARRATIVE=false

MAX_FILE_SIZE_MB=20
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
